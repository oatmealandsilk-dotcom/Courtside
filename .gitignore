node_modules/
.expo/
dist/
web-build/
*.log
npm-debug.*
yarn-error.*
.DS_Store
*.orig.*
ios/
android/
# Except CourtSide's own native modules: their phone code in modules/<name>/ios and
# /android is written by hand, unlike the ./ios and ./android that prebuild makes.
!/modules/*/ios/
!/modules/*/android/
.env*.local
expo-env.d.ts

# Local secrets and config. Copy .env.example to .env and fill it in.
.env
.env.*
!.env.example
google-play-service-account.json
# Firebase's Android push file: it goes to Expo's build service as a file variable (see docs/android-setup.md).
google-services.json
# Firebase's private key for push (FCM V1): it is uploaded to Expo, never kept here.
*firebase-adminsdk*.json
.claude/

# This Mac's own preview look in Expo Go (see app.config.js)
.courtside-local.json
