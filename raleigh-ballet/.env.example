# Copy this file to ".env.local" and fill in the values. Never commit real keys.

# --- Database (Supabase → Project Settings → Database → Connection string → "Transaction pooler") ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rsb

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (Developers → API keys / Webhooks) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- PayPal (developer.paypal.com → Apps & Credentials) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox

# --- Email ---
RESEND_API_KEY=
EMAIL_FROM="The Raleigh School of Ballet <office@raleighballet.com>"

# --- SMS (optional) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- App ---
APP_URL=http://localhost:3000
# Long random strings. CRON_SECRET protects the scheduled jobs; APP_SECRET signs
# the one-click links in emails and the demo-mode login cookie.
CRON_SECRET=change-me
APP_SECRET=change-me-too

# Demo mode: no Supabase / Stripe / PayPal / Resend needed. Sign in as any seeded
# person from a list, payments succeed instantly, emails are only logged.
# NEVER set this on the live site.
DEMO_MODE=true
